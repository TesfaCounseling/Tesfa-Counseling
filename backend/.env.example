FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret
# Local dev: leave DATABASE_URL empty to use SQLite at LOCAL_DATABASE_PATH.
# Production (Render): set DATABASE_URL to your Postgres connection string.
DATABASE_URL=
LOCAL_DATABASE_PATH=C:/dev/tesfa-counseling/tesfa_counseling.db
DATABASE_CONNECT_TIMEOUT=30
DATABASE_STATEMENT_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DAILY_API_KEY=
STRIPE_SECRET_KEY=

# Email — prefer Brevo HTTPS API in production (300 free emails/day)
# Create key: Brevo → SMTP & API → API keys. Verify sender/domain first.
BREVO_API_KEY=
SMTP_FROM=noreply@tesfacounseling.com
# Optional SMTP fallback (not needed when BREVO_API_KEY is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APP_URL=https://www.tesfacounseling.com
APP_NAME=Tesfa Counseling

# Diaspora remittance payment instructions (shown on /appointments/:id/pay)
PAYMENT_ACCOUNT_NAME=Tesfa Counseling
PAYMENT_ACCOUNT_DETAILS=Bank: Commercial Bank of Ethiopia\nAccount name: Tesfa Counseling\nAccount number: YOUR-ACCOUNT-NUMBER\nBranch: Addis Ababa
PAYMENT_ACCEPTED_METHODS=Remitly, TapTap Send, Wise, Western Union, CBE
PAYMENT_INSTRUCTIONS_NOTES=Put the Tesfa payment reference in the transfer memo so we can match your payment.
API_PUBLIC_URL=https://tesfa-counseling.onrender.com/api/v1
# Testing-phase page feedback (on by default; set BETA_FEEDBACK_ENABLED=false to disable)
BETA_FEEDBACK_ENABLED=true
